{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // https://code.visualstudio.com/docs/python/debugging#_set-configuration-options
            "name": "qtpy_datalogger [with args]",
            "type": "debugpy",
            "request": "launch",
            "module": "qtpy_datalogger",
            // Update the arugments to match the debug case
            "args": [
                // "--verbose",
                // "connect",
                // "--discover-only",
                // "equip",
                // "--compare",
                "run",
                "scanner",
                // "--help",
            ],
            // Useful options to toggle in some situations
            "justMyCode": false,
            "stopOnEntry": false,
            "autoReload": {
                "enable": false
            },
        },
        {
            "name": "Active File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "python inline",
            "type": "debugpy",
            "request": "launch",
            "code": "import qtpy_datalogger.equip; qtpy_datalogger.equip._handle_list_builtin_modules(equip._FALLBACK_QTPY_BOARD_ID)",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Attach using Process Id",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
    ]
}
